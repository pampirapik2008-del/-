{
	"name": "monster-awakening",
	"version": "3.0.0",
	"private": true,
	"description": "Пробуждение монстров — игра в одном HTML-файле. src/ + assets/ собираются в index.html.",
	"type": "module",
	"scripts": {
		"build": "node tools/build.mjs",
		"build:dist": "node tools/build.mjs --dist",
		"check": "node tools/build.mjs --check",
		"test": "node --test tests/unit/*.test.mjs",
		"golden": "node tools/golden.mjs --check",
		"golden:quick": "node tools/golden.mjs --check --battles 60 --maps 150",
		"golden:record": "node tools/golden.mjs --record",
		"fuzz": "node tools/fuzz-saves.mjs",
		"soak": "node tools/soak.mjs",
		"perf": "node tools/perf.mjs",
		"shots": "node tools/shots.mjs",
		"lint": "node tools/lint.mjs",
		"shotdiff": "node tools/shotdiff.mjs",
		"e2e": "node tools/e2e.mjs",
		"abcmd": "node tools/abcmd.mjs",
		"all": "npm run check && npm run lint && npm test && npm run fuzz && npm run golden"
	},
	"devDependencies": {
		"@napi-rs/canvas": "^1.1.1"
	},
	"engines": {
		"node": ">=18"
	}
}
